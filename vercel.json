{
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
        {
            "source": "/(.*)\\.(css|js|png|jpg|jpeg|gif|svg)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "pdfspacer.vercel.app"
                }
            ],
            "destination": "https://www.pdfspacer.com/:path*",
            "permanent": true
        },
        {
            "source": "/demo",
            "destination": "/guide",
            "permanent": true
        }
    ]
}
